{
  "name": "solstice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local db/migrate.mjs",
    "db:migrate:live": "node --env-file-if-exists=.env.local db/migrate.mjs --live",
    "test:e2e": "playwright test",
    "test:smoke": "NEXCONN_SMOKE=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run smoke"
  },
  "dependencies": {
    "@nexconn/chat": "26.5.1",
    "@nexconn/engine": "26.5.1",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
