# Copy this file to .env.local and set real values. The server refuses to start on a placeholder.
DATABASE_URL=replace-with-the-postgres-url
SESSION_SECRET=replace-with-32-or-more-random-characters

# Only for `npm run db:migrate:live`: the direct (not pooled) address of the hosted database.
DATABASE_URL_DIRECT=

# Set CHAT=off to run production with chat switched off. Leave it empty when the Nexconn keys are set.
CHAT=

# From the Nexconn console. Region is one of: sg, na, sau.
# Leave all three empty in local development to run with chat switched off.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_REGION=
